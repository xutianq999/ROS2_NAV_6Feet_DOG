<?xml version="1.0"?>
<!--
  Dobot Hexplorer (miniHex_v2 / DT-HEX-6R010-L) 导航用机器人描述。

  只保留 Nav2 栈需要的三个坐标系名（与原 Bunker 版 URDF 一致，下游零改动）：
    base_footprint  地面投影原点（Super-LIO 桥接层 / Nav2 robot_base_frame）
    chassis         机身几何中心
    livox_frame     Livox MID-360（pointcloud_to_laserscan 的 target_frame）

  尺寸来源（Hexplorer 用户手册 V1.6，2025-09-30）：
    - 站立尺寸 863 × 470 × 480 mm（长宽高）
    - 雷达相对几何中心：X +382.17 mm，Z +96.17 mm，安装面与水平夹角 15°
      （手册 33 页"雷达与几何中心坐标系相对数据"）

  ⚠ 实机校准点（上电后建议做一次，改这里即可）：
    1. chassis 高度：机器人 balanceStand 站立后
       `ros2 topic echo /robot_state` 读 pos_body[2]（单位 m），
       把下面 base_to_chassis 的 0.25 改成实测值。
    2. 雷达俯仰方向：手册图上 15° 按"前倾(低头)"处理。若实机是后仰，
       把 livox 的 rpy pitch 改成 -0.2618。上电后也可对照 vendor
       livox_lidar_node 发布的 /tf_static（机器人坐标系→雷达 link）核对。
    3. vendor 的 mini_hex_v2 URDF（18 自由度腿部模型）在
       robot_controller_release/ros2_packages/mini_hex_v2/，需要看
       腿部运动学时用它；本文件只服务导航/可视化，不引入关节 TF。
-->
<robot name="hexplorer_mini_hex_v2">

  <!-- ==================== Materials ==================== -->
  <material name="body_blue">
    <color rgba="0.23 0.42 0.78 1.0"/>
  </material>
  <material name="body_dark">
    <color rgba="0.16 0.18 0.21 1.0"/>
  </material>
  <material name="lidar_body">
    <color rgba="0.12 0.13 0.15 1.0"/>
  </material>
  <material name="lidar_lens">
    <color rgba="0.02 0.05 0.12 0.95"/>
  </material>

  <!-- ==================== Base Footprint ==================== -->
  <!-- 地面投影。站立时机身几何中心约在 0.25 m（待实测，见文件头说明） -->
  <link name="base_footprint"/>

  <joint name="base_to_chassis" type="fixed">
    <parent link="base_footprint"/>
    <child link="chassis"/>
    <origin xyz="0.0 0.0 0.25" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Chassis（机身几何中心） ==================== -->
  <!-- 腿部髋关节安装在 x=±0.3003 / y=±0.05（mini_hex_v2 URDF），
       机身主体约 0.64 × 0.24 m；腿部包络进 Nav2 的 footprint 里，
       这里的碰撞体只画机身。 -->
  <link name="chassis">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.64 0.24 0.20"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <visual>
      <!-- 顶部载物面板 -->
      <origin xyz="0.0 0.0 0.105" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.22 0.012"/>
      </geometry>
      <material name="body_dark"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.66 0.26 0.22"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="20.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.30" ixy="0.0" ixz="0.0" iyy="0.90" iyz="0.0" izz="1.00"/>
    </inertial>
  </link>

  <!-- ==================== Livox MID-360 ==================== -->
  <!-- 手册：相对几何中心 X+382.17mm / Z+96.17mm，俯倾 15°（方向待核对）。
       livox_frame 原点 = MID-360 光学中心（即其内置 IMU 位置附近），
       与 super_lio_bridge 的 imu_to_base 外参一一对应。 -->
  <link name="livox_frame">
    <visual>
      <origin xyz="0.0 0.0 -0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.03"/>
      </geometry>
      <material name="lidar_body"/>
    </visual>
    <visual>
      <origin xyz="0.0 0.0 0.012" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.024"/>
      </geometry>
      <material name="lidar_lens"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="chassis_to_livox_frame" type="fixed">
    <parent link="chassis"/>
    <child link="livox_frame"/>
    <!-- 0.2618 rad = 15°。若实机是后仰改为 -0.2618（同步改 bridge.yaml）。 -->
    <origin xyz="0.382 0.0 0.096" rpy="0 0.2618 0"/>
  </joint>

</robot>
